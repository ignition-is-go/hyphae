+        let keys = map.keys().materialize();
+        let notifications = Arc::new(AtomicUsize::new(0));
+        let observed = notifications.clone();
+        let _guard = keys.subscribe(move |_| {
+            observed.fetch_add(1, Ordering::SeqCst);
